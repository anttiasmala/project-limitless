# Tells where the PartyServer worker is hosted. Can be http://localhost:8787 for locally
# hosting (only your computer) - 8787 is `wrangler dev`'s default port.
# Or you can put your internal IP, for example: http://192.168.1.1:8787 if wanting to test with other device (e.g. phone)
# In production this is the deployed worker, e.g. https://pirate-tictactoe-party.<subdomain>.workers.dev
NEXT_PUBLIC_PARTYKIT_HOST=http://localhost:8787

# Without this, I could not test the site properly with my phone
# This should be the internal IP of you computer, for example 192.168.1.1
# Next.js allows dev requests from it, and backend/auth/auth.ts trusts it as a
# login origin, so signing in from the phone works too.
ALLOWED_DEV_ORIGINS=192.168.1.1