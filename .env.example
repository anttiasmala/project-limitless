

# Add a secret key for Better-Auth. It must be at least 32 characters.
# Easiest way is to use the following command "openssl rand -base64 32". NOTE: that the key can be longer than 32 characters

# The key should look something like this:
BETTER_AUTH_SECRET=qPlnwFj7Cb9v7i0sDwIxdl7+bAJuQK+wVQxTJyrzZn5ISkhbTzd/RejDadcx3GM2CxuonJ80bqzZCC8oM4Au9g==

# The URL the app is served from, used by Better-Auth for callbacks and
# redirects. Set this when deploying, for example:
# BETTER_AUTH_URL=https://example.com
#
# Leave it unset in development. backend/auth/auth.ts then allows localhost and
# the ALLOWED_DEV_ORIGINS host from .env.local, so testing from a phone keeps
# working instead of being redirected to localhost.

# README.md's section "Setting the environment variables" will help with this
DATABASE_URL="postgresql://databaseusername:databasepassword@localhost:5432/exampleDB?schema=public"